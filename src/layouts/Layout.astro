---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import BackToTop from "../components/BackToTop.astro";
import pkg from "../../package.json";
import links from "../data/links.json";
import { LINK_ICONS } from "../icons/link-icons";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dileepa Bandara | Links",
  description = "Building AI systems and the community around them.",
} = Astro.props;

const site = Astro.site ?? new URL("https://links.dileepa.dev");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

// Everything but the mailto entry counts as a social/reference profile of
// the same person - Person.sameAs, matching the shape dileepa-dev builds.
const sameAs = links
  .filter((l) => l.url && !l.url.startsWith("mailto:"))
  .map((l) => l.url);

// Match the main site: the displayed version links to that version's release.
// A deployment can lead or trail GitHub's latest release, so keep them paired.
const repoUrl = pkg.repository.url.replace(/\.git$/, "");
const releaseUrl = `${repoUrl}/releases/tag/v${pkg.version}`;
const hasProfile = Astro.slots.has("profile");

const personId = new URL("/#person", site).href;
const websiteId = new URL("/#website", site).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: "Dileepa Bandara",
    alternateName: "dileepadev",
    url: site.href,
    jobTitle: "AI Engineer",
    sameAs,
    image: ogImage,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    name: title,
    url: site.href,
    description,
    inLanguage: "en",
    publisher: { "@id": personId },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- The token sheet's own font @import doesn't survive being vendored
         under `@layer` - `@import` is invalid there per spec, and the CSS
         optimiser drops it with a warning. Loaded here instead, same URL,
         same fonts, same weights. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />

    <meta property="og:site_name" content="links.dileepa.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dileepadev" />
    <meta name="twitter:creator" content="@dileepadev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={description} />

    <link rel="image_src" href={ogImage} />
    <meta name="robots" content="index, follow" />

    <!-- The favicon is the portrait, at every size - brand-guide.md §3.2 -
         matching dileepa-dev rather than the reduced `/.` mark. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/apple-icon-180x180.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/manifest.json" />

    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      content="#050505"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#f7f7f7"
      media="(prefers-color-scheme: light)"
    />

    <title>{title}</title>

    {
      jsonLd.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }

    <!-- Applies the persisted theme before first paint, so there is no
         flash of the wrong theme. One storage key across the platform -
         design-system.md §11 - "dileepa-theme". -->
    <script is:inline>
      (function () {
        try {
          var KEY = "dileepa-theme";
          var stored = localStorage.getItem(KEY);
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (err) {
          // Leave the token sheet's default (dark) in place.
        }
      })();
    </script>
  </head>
  <body>
    <header class:list={["site-header", hasProfile && "site-header--profile"]}>
      <div class="container">
        <div class="nav">
          <a href="/" class="lockup" aria-label="dileepadev — links">
            <span class="mark" aria-hidden="true">@</span><span class="wordmark"
              >dileepadev</span
            >
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class:list={["page-shell", hasProfile && "page-shell--profile"]}>
      <slot name="profile" />
      <div class="page-column">
        <main><slot /></main>

        <footer class="site-footer">
          <div class="footer-bottom">
            <div class="footer-legal">
              <span>&copy; {new Date().getFullYear()} Dileepa Bandara</span>
            </div>
            <div class="footer-meta">
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View source on GitHub"
              >
                <Fragment set:html={LINK_ICONS.github} />
                <span>Source</span>
              </a>
              <span class="footer-sep" aria-hidden="true">/</span>
              <a
                href={releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Version ${pkg.version}: view this release on GitHub`}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"
                  ></path>
                  <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </svg>
                <span>v{pkg.version}</span>
              </a>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <BackToTop />
  </body>
</html>

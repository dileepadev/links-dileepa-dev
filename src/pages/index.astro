---
import Layout from "../layouts/Layout.astro";
import LinkCard from "../components/LinkCard.astro";
import QrModal from "../components/QrModal.astro";
import ProfilePanel from "../components/ProfilePanel.astro";
import groups from "../data/links.json";

const title = "Dileepa Bandara | Links";
const description =
  "Building AI systems and the community around them. Find my socials and other links below.";
const linkGroups = groups.map((group) => ({
  ...group,
  id: `links-${group.group.toLowerCase().replace(/\s+/g, "-")}`,
}));
---

<Layout title={title} description={description}>
  <ProfilePanel
    slot="profile"
    sections={linkGroups.map((group) => ({ name: group.group, id: group.id }))}
  />

  <section class="links-panel" aria-labelledby="links-title">
    <div class="links-panel-head">
      <h2 id="links-title">Links</h2>
      <p>My sites, social profiles and ways to get in touch.</p>
    </div>
    {
      linkGroups.map((group) => (
        <section
          class="link-group"
          id={group.id}
          aria-labelledby={`${group.id}-title`}
        >
          <p class="link-group-title" id={`${group.id}-title`}>
            {group.group}
          </p>
          <div class="links">
            {group.links.map((link) => (
              <LinkCard link={link} />
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <QrModal />

  <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
  <div
    id="toast"
    class="toast"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 8v4m0 4h.01"></path>
    </svg>
    <span id="copy-error-message"></span>
  </div>
</Layout>

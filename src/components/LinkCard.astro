---
import "../styles/components/link-card.css";
import { LINK_ICONS } from "../icons/link-icons";

interface Props {
  link: { name: string; handle: string; url: string; icon: string };
}

const { link } = Astro.props as Props;
const icon = LINK_ICONS[link.icon] ?? "";
const isExternal = !link.url.startsWith("mailto:");
---

<div class="link-card" data-name={link.name}>
  <a
    href={link.url}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class="link-card-hit"
    aria-label={link.name}></a>
  <span class="link-card-icon" set:html={icon} />
  <span class="link-card-body">
    <span class="link-card-name">{link.name}</span>
    <span class="link-card-handle">{link.handle}</span>
  </span>
  <div class="link-card-actions">
    <button
      type="button"
      class="link-card-action link-card-qr"
      title={`Show QR code for ${link.name}`}
      aria-label={`Show QR code for ${link.name}`}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
        <line x1="14" y1="14" x2="14" y2="14.01"></line>
        <line x1="17.5" y1="14" x2="17.5" y2="17.5"></line>
        <line x1="14" y1="17.5" x2="17.5" y2="17.5"></line>
        <line x1="14" y1="21" x2="17.5" y2="21"></line>
        <line x1="21" y1="17.5" x2="21" y2="21"></line>
      </svg>
    </button>
    <button
      type="button"
      class="link-card-action link-card-copy copy-btn"
      data-url={link.url}
      title={`Copy link to ${link.name}`}
      aria-label={`Copy link to ${link.name}`}
    >
      <svg
        class="copy-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
        ></path>
      </svg>
      <svg
        class="copy-tick"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const status = document.getElementById("copy-status");
  const toast = document.getElementById("toast");
  const errorMessage = document.getElementById("copy-error-message");
  let announcementTimer: ReturnType<typeof setTimeout> | undefined;
  let errorTimer: ReturnType<typeof setTimeout> | undefined;

  function hideError() {
    toast?.classList.remove("is-visible");
    if (errorMessage) errorMessage.textContent = "";
  }

  async function writeClipboard(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    // Plain-HTTP previews and older browsers have no Clipboard API.
    const focused = document.activeElement;
    const area = document.createElement("textarea");
    area.value = text;
    area.readOnly = true;
    area.tabIndex = -1;
    area.setAttribute("aria-hidden", "true");
    area.style.position = "fixed";
    area.style.opacity = "0";
    document.body.append(area);
    try {
      area.select();
      if (!document.execCommand("copy"))
        throw new Error("Copy command refused");
    } finally {
      area.remove();
      if (focused instanceof HTMLElement)
        focused.focus({ preventScroll: true });
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>(".copy-btn")
    .forEach((button) => {
      const label = button.getAttribute("aria-label")!;
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      function reset() {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", label);
        button.title = label;
      }

      button.addEventListener("click", async () => {
        const url = button.dataset.url;
        if (!url) return;

        try {
          await writeClipboard(url);
        } catch {
          clearTimeout(resetTimer);
          reset();
          if (errorMessage) {
            errorMessage.textContent = `Copy failed. Copy this address instead: ${url}`;
          }
          toast?.classList.add("is-visible");
          clearTimeout(errorTimer);
          errorTimer = setTimeout(hideError, 4000);
          return;
        }

        hideError();
        clearTimeout(errorTimer);
        button.classList.add("is-copied");
        button.setAttribute("aria-label", "Copied");
        button.title = "Copied";
        clearTimeout(resetTimer);
        resetTimer = setTimeout(reset, 2000);

        // Clearing first lets assistive technology announce repeated copies.
        clearTimeout(announcementTimer);
        if (status) status.textContent = "";
        announcementTimer = setTimeout(() => {
          if (status) status.textContent = "Copied to clipboard";
        }, 50);
      });
    });
</script>

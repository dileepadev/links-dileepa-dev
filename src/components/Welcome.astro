---
import links from "../data/links.json";
---

<div class="relative w-full py-10 px-4 overflow-hidden">
  <!-- Background Gradient Blob -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-150 h-100 bg-accent-blue/5 rounded-full blur-3xl -z-10 opacity-50 dark:opacity-20 pointer-events-none"
  >
  </div>

  <main class="max-w-xl mx-auto relative z-10">
    <header class="text-center mb-12 animate-fade-in">
      <h1
        class="text-4xl md:text-5xl font-extrabold text-text-primary mb-3 tracking-tight"
      >
        Dileepa Bandara
      </h1>
      <p class="text-xl text-text-secondary">
        Find my social and external links below
      </p>
    </header>

    <div class="space-y-4">
      {
        links.map((link) => (
          <div class="group relative flex items-center p-4 rounded-xl bg-bg-secondary border border-border-light hover:border-accent-blue hover:bg-bg-tertiary transition-all duration-300 shadow-sm hover:shadow-md">
            {/* Social Icon */}
            <div
              class="w-12 h-12 flex items-center justify-center rounded-lg bg-bg-primary text-accent-blue shadow-inner group-hover:scale-110 transition-transform duration-300"
              set:html={link.svg}
            />

            {/* Content */}
            <div class="ml-4 grow">
              <h2 class="text-lg font-bold text-text-primary group-hover:text-accent-blue transition-colors">
                {link.name}
              </h2>
              <p class="text-sm text-text-muted">{link.handle}</p>
            </div>

            {/* Actions */}
            <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10">
              <button
                class="copy-btn p-2 rounded-lg bg-bg-primary text-text-muted hover:text-accent-blue hover:bg-accent-blue/10 transition-colors cursor-pointer"
                data-url={link.url}
                title="Copy Link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </>
                </svg>
              </button>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-lg bg-bg-primary text-text-muted hover:text-accent-blue hover:bg-accent-blue/10 transition-colors"
                title="Open Link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M15 3h6v6" />
                    <path d="M10 14 21 3" />
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </>
                </svg>
              </a>
            </div>

            {/* Mobile Link Overlay */}
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="absolute inset-0 z-0 sm:hidden"
              aria-label={link.name}
            />
          </div>
        ))
      }
    </div>

    <!-- Status Message (Toast) -->
    <div
      id="status-msg"
      class="fixed bottom-8 left-1/2 -translate-x-1/2 px-6 py-3 bg-text-primary text-bg-primary rounded-full text-sm font-bold shadow-xl opacity-0 transition-opacity duration-300 pointer-events-none z-50 flex items-center gap-2 tracking-wide"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><polyline points="20 6 9 17 4 12"></polyline></svg
      >
      Copied to clipboard!
    </div>
  </main>
</div>

<script>
  const copyButtons = document.querySelectorAll(".copy-btn");
  const statusMsg = document.getElementById("status-msg");

  copyButtons.forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const url = btn.getAttribute("data-url");
      if (url) {
        try {
          await navigator.clipboard.writeText(url);
          if (statusMsg) {
            statusMsg.classList.remove("opacity-0");
            setTimeout(() => {
              statusMsg.classList.add("opacity-0");
            }, 2000);
          }
        } catch (err) {
          console.error("Failed to copy: ", err);
        }
      }
    });
  });
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }
</style>
